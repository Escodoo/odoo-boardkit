<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_dashboard" model="ir.module.category">
        <field name="name">Dashboard</field>
        <field name="sequence">45</field>
    </record>

    <!-- Model access is granted to base.group_user in ir.model.access.csv, not
         to the groups below: internal users outside them still need to read the
         boards aimed at their own groups through Allowed Groups. Since Dashboard
         User implies base.group_user, it inherits that access, so the groups only
         drive the record rules and the menu visibility. -->
    <record id="group_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_dashboard" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_dashboard" />
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]" />
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_dashboard_manager'))]" />
    </record>

    <record id="rule_dashboard_company" model="ir.rule">
        <field name="name">Dashboard: multi-company</field>
        <field name="model_id" ref="model_boardkit_dashboard" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dashboard_item_company" model="ir.rule">
        <field name="name">Dashboard Item: multi-company</field>
        <field name="model_id" ref="model_boardkit_dashboard_item" />
        <field
            name="domain_force"
        >['|', ('dashboard_id.company_id', '=', False), ('dashboard_id.company_id', 'in', company_ids)]</field>
