            name="domain_force"
        >['&amp;', ('active', '=', True), ('published', '=', True), ('group_ids', '!=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="rule_dashboard_group_access_manager" model="ir.rule">
        <field name="name">Dashboard: managers see everything</field>
        <field name="model_id" ref="model_boardkit_dashboard" />
        <field name="domain_force">[(1, '=', 1)]</field>
