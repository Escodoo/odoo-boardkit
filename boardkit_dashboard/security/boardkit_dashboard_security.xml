    <!-- Dashboard User: active published boards; unrestricted or matching Allowed Groups. -->
    <record id="rule_dashboard_group_access_user" model="ir.rule">
        <field name="name">Dashboard: group access for users</field>
        <field name="model_id" ref="model_boardkit_dashboard" />
        <field
            name="domain_force"
        >['&amp;', ('active', '=', True), ('published', '=', True), '|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_user'))]" />
    </record>

    <!-- Internal users without Dashboard User: active published boards with matching Allowed Groups. -->
    <record id="rule_dashboard_group_access_audience" model="ir.rule">
        <field name="name">Dashboard: group access for audience</field>
        <field name="model_id" ref="model_boardkit_dashboard" />
