<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="boardkit_dashboard.DateFilter" owl="1">
        <div
            class="o_boardkit_dashboard_date_filter d-flex align-items-center gap-2 flex-wrap"
        >
            <Dropdown togglerClass="'btn btn-secondary btn-sm'" showCaret="false">
                <t t-set-slot="toggler">
                    <i
                        class="fa fa-calendar me-1"
                        role="img"
                        aria-label="Date filter"
                    />
                    <t t-esc="currentLabel" />
                    <i class="fa fa-caret-down ms-1" role="img" aria-label="Open" />
                </t>
                <t t-foreach="props.presets" t-as="preset" t-key="preset[0]">
                    <DropdownItem
                        onSelected="() => this.onPresetSelected(preset[0])"
                        class="{'fw-bold': preset[0] === props.value.preset}"
                    >
                        <t t-esc="preset[1]" />
                    </DropdownItem>
                </t>
            </Dropdown>
            <t t-if="isCustom">
                <DatePicker
                    date="state.customFrom || false"
                    onDateTimeChanged="(value) => { state.customFrom = value; }"
                    placeholder.translate="Start date"
                />
                <i
                    class="fa fa-long-arrow-right text-muted"
                    role="img"
                    aria-label="to"
                />
                <DatePicker
                    date="state.customTo || false"
                    onDateTimeChanged="(value) => { state.customTo = value; }"
                    placeholder.translate="End date"
                />
                <button
                    class="btn btn-primary btn-sm"
                    t-on-click="onApplyCustom"
                >Apply</button>
            </t>
        </div>
    </t>
</templates>
