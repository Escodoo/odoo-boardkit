<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="dashboard_demo_palette" model="boardkit.dashboard.palette">
        <field name="name">Boardkit Brand</field>
        <field
            name="color_ids"
            eval="[
                (0, 0, {'sequence': 10, 'color': '#8B5CF6'}),
                (0, 0, {'sequence': 20, 'color': '#A78BFA'}),
                (0, 0, {'sequence': 30, 'color': '#6D28D9'}),
                (0, 0, {'sequence': 40, 'color': '#C4B5FD'}),
                (0, 0, {'sequence': 50, 'color': '#4C1D95'}),
            ]"
        />
    </record>

    <record id="dashboard_demo" model="boardkit.dashboard">
        <field name="name">Contacts Overview</field>
        <field name="date_filter">none</field>
        <field name="published" eval="True" />
        <field name="default_color_palette">custom</field>
        <field name="default_palette_id" ref="dashboard_demo_palette" />
    </record>

    <record id="dashboard_demo_filter_companies" model="boardkit.dashboard.filter">
        <field name="name">Companies</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="model_id" ref="base.model_res_partner" />
        <field name="domain">[("is_company", "=", True)]</field>
    </record>

    <record id="dashboard_demo_item_tile" model="boardkit.dashboard.item">
        <field name="name">Total Contacts</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">tile</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="icon">fa-users</field>
    </record>

    <record id="dashboard_demo_item_kpi" model="boardkit.dashboard.item">
        <field name="name">Contacts Target</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">kpi</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="kpi_mode">target</field>
        <field name="target_enabled" eval="True" />
        <field name="target_value">100</field>
    </record>

    <record id="dashboard_demo_item_bar" model="boardkit.dashboard.item">
        <field name="name">Contacts by Country</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">bar</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="group_by_field_id" ref="base.field_res_partner__country_id" />
        <field name="chart_sort">value_desc</field>
        <field name="record_limit">10</field>
    </record>

    <record id="dashboard_demo_item_bar_drill" model="boardkit.dashboard.item.drill">
        <field name="item_id" ref="dashboard_demo_item_bar" />
        <field name="sequence">10</field>
        <field name="group_by_field_id" ref="base.field_res_partner__is_company" />
        <field name="chart_type">pie</field>
    </record>

    <record id="dashboard_demo_item_line" model="boardkit.dashboard.item">
        <field name="name">New Contacts per Month</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">line</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="group_by_field_id" ref="base.field_res_partner__create_date" />
        <field name="group_by_granularity">month</field>
        <field name="date_field_id" ref="base.field_res_partner__create_date" />
    </record>

    <record id="dashboard_demo_item_pie" model="boardkit.dashboard.item">
        <field name="name">Companies vs Individuals</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">pie</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="group_by_field_id" ref="base.field_res_partner__is_company" />
        <field name="boolean_true_label">Company</field>
        <field name="boolean_false_label">Individual</field>
        <field name="color_palette">custom</field>
        <field name="palette_id" ref="dashboard_demo_palette" />
    </record>

    <record id="dashboard_demo_item_list" model="boardkit.dashboard.item">
        <field name="name">Latest Contacts</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">list</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="list_type">plain</field>
        <field name="sort_field_id" ref="base.field_res_partner__create_date" />
        <field name="sort_dir">desc</field>
        <field name="page_size">8</field>
    </record>
    <record
        id="dashboard_demo_item_list_col_name"
        model="boardkit.dashboard.item.column"
    >
        <field name="item_id" ref="dashboard_demo_item_list" />
        <field name="sequence">10</field>
        <field name="field_id" ref="base.field_res_partner__name" />
    </record>
    <record
        id="dashboard_demo_item_list_col_email"
        model="boardkit.dashboard.item.column"
    >
        <field name="item_id" ref="dashboard_demo_item_list" />
        <field name="sequence">20</field>
        <field name="field_id" ref="base.field_res_partner__email" />
    </record>
    <record
        id="dashboard_demo_item_list_col_country"
        model="boardkit.dashboard.item.column"
    >
        <field name="item_id" ref="dashboard_demo_item_list" />
        <field name="sequence">30</field>
        <field name="field_id" ref="base.field_res_partner__country_id" />
    </record>

    <record id="dashboard_demo_item_funnel" model="boardkit.dashboard.item">
        <field name="name">Contacts Funnel by Country</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">funnel</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="group_by_field_id" ref="base.field_res_partner__country_id" />
        <field name="record_limit">8</field>
    </record>

    <record id="dashboard_demo_item_gauge" model="boardkit.dashboard.item">
        <field name="name">Contacts Gauge</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">gauge</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="target_enabled" eval="True" />
        <field name="target_value">100</field>
        <field name="gauge_max">120</field>
    </record>

    <record id="dashboard_demo_item_bullet" model="boardkit.dashboard.item">
        <field name="name">Contacts Bullet by Country</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">bullet</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="group_by_field_id" ref="base.field_res_partner__country_id" />
        <field name="chart_sort">value_desc</field>
        <field name="record_limit">5</field>
        <field name="target_enabled" eval="True" />
        <field name="target_value">10</field>
    </record>

    <record id="dashboard_demo_item_map" model="boardkit.dashboard.item">
        <field name="name">Contacts Map</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">map</field>
        <field name="map_mode">regions</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="group_by_field_id" ref="base.field_res_partner__country_id" />
    </record>

    <!-- Geolocalized demo partners (requires partner_latitude / partner_longitude). -->
    <record id="dashboard_demo_partner_sp" model="res.partner">
        <field name="name">Boardkit Demo São Paulo</field>
        <field name="is_company" eval="True" />
        <field name="country_id" ref="base.br" />
        <field name="city">São Paulo</field>
        <field name="partner_latitude">-23.5505</field>
        <field name="partner_longitude">-46.6333</field>
    </record>
    <record id="dashboard_demo_partner_ny" model="res.partner">
        <field name="name">Boardkit Demo New York</field>
        <field name="is_company" eval="True" />
        <field name="country_id" ref="base.us" />
        <field name="city">New York</field>
        <field name="partner_latitude">40.7128</field>
        <field name="partner_longitude">-74.006</field>
    </record>
    <record id="dashboard_demo_partner_lisbon" model="res.partner">
        <field name="name">Boardkit Demo Lisbon</field>
        <field name="is_company" eval="True" />
        <field name="country_id" ref="base.pt" />
        <field name="city">Lisbon</field>
        <field name="partner_latitude">38.7223</field>
        <field name="partner_longitude">-9.1393</field>
    </record>

    <record id="dashboard_demo_item_map_points" model="boardkit.dashboard.item">
        <field name="name">Contacts by Location</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">map</field>
        <field name="map_mode">points</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field
            name="domain"
            eval="str([('id', 'in', [ref('dashboard_demo_partner_sp'), ref('dashboard_demo_partner_ny'), ref('dashboard_demo_partner_lisbon')])])"
        />
        <field
            name="latitude_field_id"
            ref="base.field_res_partner__partner_latitude"
        />
        <field
            name="longitude_field_id"
            ref="base.field_res_partner__partner_longitude"
        />
    </record>

    <record id="dashboard_demo_item_map_points_br" model="boardkit.dashboard.item">
        <field name="name">Brazil Contacts Map</field>
        <field name="dashboard_id" ref="dashboard_demo" />
        <field name="item_type">map</field>
        <field name="map_mode">points</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="aggregation">count</field>
        <field name="map_focus_country_id" ref="base.br" />
        <field
            name="domain"
            eval="str([('id', 'in', [ref('dashboard_demo_partner_sp'), ref('dashboard_demo_partner_ny'), ref('dashboard_demo_partner_lisbon')])])"
        />
        <field
            name="latitude_field_id"
            ref="base.field_res_partner__partner_latitude"
        />
        <field
            name="longitude_field_id"
            ref="base.field_res_partner__partner_longitude"
        />
    </record>
</odoo>
