<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="boardkit_dashboard_template_view_list" model="ir.ui.view">
        <field name="name">boardkit.dashboard.template.list</field>
        <field name="model">boardkit.dashboard.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="key" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="boardkit_dashboard_template_view_form" model="ir.ui.view">
        <field name="name">boardkit.dashboard.template.form</field>
        <field name="model">boardkit.dashboard.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="key" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" invisible="1" />
                        <field
                            name="payload_text"
                            nolabel="1"
                            colspan="2"
                            widget="text"
                            options="{'resizable': true}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="boardkit_dashboard_template_action" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">boardkit.dashboard.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="boardkit_dashboard_template_wizard_view_form" model="ir.ui.view">
        <field name="name">boardkit.dashboard.template.wizard.form</field>
        <field name="model">boardkit.dashboard.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Create from Template">
                <group>
                    <field
                        name="template_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="name" placeholder="Keep template name" />
                </group>
                <footer>
                    <button
                        name="action_create"
                        type="object"
                        string="Create Dashboard"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="boardkit_dashboard_template_wizard_action"
        model="ir.actions.act_window"
    >
        <field name="name">From Template</field>
        <field name="res_model">boardkit.dashboard.template.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
