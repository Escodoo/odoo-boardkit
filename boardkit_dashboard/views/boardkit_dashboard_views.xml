<odoo>
    <record id="boardkit_dashboard_view_form" model="ir.ui.view">
        <field name="name">boardkit.dashboard.form</field>
        <field name="model">boardkit.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <header>
                    <button
                        name="action_open_dashboard"
                        type="object"
                        string="View Dashboard"
                        class="btn-primary"
                    />
                    <button
                        name="action_publish"
                        type="object"
                        string="Publish"
                        class="btn-secondary"
                        groups="boardkit_dashboard.group_dashboard_manager"
                        attrs="{'invisible': [('published', '!=', False)]}"
                    />
                    <button
                        name="action_unpublish"
                        type="object"
                        string="Unpublish"
                        class="btn-secondary"
                        groups="boardkit_dashboard.group_dashboard_manager"
                        attrs="{'invisible': [('published', '=', False)]}"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '!=', False)]}"
                    />
                    <widget
                        name="web_ribbon"
                        title="Draft"
                        bg_color="bg-warning"
                        attrs="{'invisible': ['|', ('published', '!=', False), ('active', '=', False)]}"
                    />
                    <field name="active" invisible="1" />
                    <field name="published" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Sales Overview" />
                        </h1>
                        <field
                            name="description"
                            placeholder="Short summary of this dashboard"
                        />
                        <div class="mt-2 mb-3">
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                                placeholder="Tags"
                            />
                        </div>
                    </div>
                    <group>
                        <group name="settings">
                            <field name="company_id" options="{'no_create': True}" />
                            <field name="icon" placeholder="Inherit from tags" />
                            <field name="refresh_interval" />
                            <field name="date_filter" />
                            <field
                                name="date_from"
                                attrs="{'invisible': [('date_filter', '!=', 'custom')], 'required': [('date_filter', '=', 'custom')]}"
                            />
                            <field
                                name="date_to"
                                attrs="{'invisible': [('date_filter', '!=', 'custom')], 'required': [('date_filter', '=', 'custom')]}"
                            />
                            <field name="default_color_palette" />
                            <field
                                name="default_palette_id"
                                options="{'no_create': True}"
                                attrs="{'invisible': [('default_color_palette', '!=', 'custom')], 'required': [('default_color_palette', '=', 'custom')]}"
                            />
                        </group>
                        <group name="menu" string="Menu &amp; Access">
                            <field
                                name="menu_as_app"
                                attrs="{'readonly': [('company_id', '!=', False)]}"
                            />
                            <field
                                name="menu_parent_id"
                                options="{'no_create': True}"
                                attrs="{'readonly': [('company_id', '!=', False)], 'invisible': [('menu_as_app', '!=', False)]}"
                            />
                            <field
                                name="menu_name"
                                placeholder="Defaults to the dashboard name"
                                attrs="{'readonly': [('company_id', '!=', False)]}"
                            />
                            <field
                                name="menu_sequence"
                                attrs="{'readonly': [('company_id', '!=', False)]}"
                            />
                            <field name="group_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <notebook>
                        <page name="items" string="Items">
                            <field
                                name="item_ids"
                                context="{'default_dashboard_id': id}"
                            >
                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="item_type" />
                                    <field name="model_id" />
                                </tree>
                            </field>
                        </page>
                        <page name="filters" string="Predefined Filters">
                            <field
                                name="filter_ids"
                                context="{'default_dashboard_id': id}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field
                                        name="model_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="model_name" invisible="1" />
                                    <field
                                        name="domain"
                                        widget="domain"
                                        options="{'model': 'model_name', 'in_dialog': True}"
                                    />
                                    <field name="default_enabled" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="boardkit_dashboard_view_kanban" model="ir.ui.view">
        <field name="name">boardkit.dashboard.kanban</field>
        <field name="model">boardkit.dashboard</field>
        <field name="arch" type="xml">
            <kanban
                class="o_boardkit_dashboard_kanban"
                js_class="boardkit_dashboard_catalogue_kanban"
                action="action_open_dashboard"
                type="object"
                default_order="is_favorite desc, name"
            >
                <field name="name" />
                <field name="description" />
                <field name="tag_ids" />
                <field name="published" />
                <field name="item_count" />
                <field name="refresh_interval" />
                <field name="palette_strip_html" />
                <field name="kanban_icon" />
                <field name="company_id" />
                <field name="is_favorite" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="o_boardkit_dashboard_kanban_card #{!record.published.raw_value ? 'o_boardkit_dashboard_kanban_card_draft' : ''}"
                        >
                            <div
                                class="o_dropdown_kanban dropdown"
                                groups="boardkit_dashboard.group_dashboard_manager"
                            >
                                <a
                                    role="button"
                                    class="dropdown-toggle o-no-caret btn"
                                    data-bs-toggle="dropdown"
                                    data-bs-display="static"
                                    href="#"
                                    aria-label="Dropdown menu"
                                    title="Dropdown menu"
                                >
                                    <span class="fa fa-ellipsis-v" />
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a
                                        class="dropdown-item"
                                        role="menuitem"
                                        name="copy"
                                        type="object"
                                    >Duplicate</a>
                                    <a
                                        class="dropdown-item"
                                        role="menuitem"
                                        type="open"
                                    >Settings</a>
                                    <a
                                        t-if="!record.published.raw_value"
                                        class="dropdown-item"
                                        role="menuitem"
                                        name="action_publish"
                                        type="object"
                                    >Publish</a>
                                    <a
                                        t-if="record.published.raw_value"
                                        class="dropdown-item"
                                        role="menuitem"
                                        name="action_unpublish"
                                        type="object"
                                    >Unpublish</a>
                                    <a
                                        class="dropdown-item text-danger"
                                        role="menuitem"
                                        type="delete"
                                    >Delete</a>
                                </div>
                            </div>
                            <div
                                t-if="record.palette_strip_html.raw_value"
                                t-out="record.palette_strip_html.raw_value"
                            />
                            <div
                                t-if="!record.published.raw_value"
                                class="ribbon ribbon-top-right o_boardkit_dashboard_kanban_ribbon"
                            >
                                <span class="bg-warning o_small">Draft</span>
                            </div>
                            <div
                                class="o_boardkit_dashboard_kanban_title d-flex align-items-center gap-2 fw-bold fs-5"
                            >
                                <span
                                    class="o_boardkit_dashboard_kanban_icon"
                                    aria-hidden="true"
                                >
                                    <i
                                        t-attf-class="fa {{ record.kanban_icon.raw_value or 'fa-th-large' }}"
                                    />
                                </span>
                                <span
                                    class="o_boardkit_dashboard_kanban_name flex-grow-1 text-truncate fw-bold"
                                    t-att-title="record.name.value"
                                    t-esc="record.name.value"
                                />
                                <field
                                    name="is_favorite"
                                    widget="boardkit_dashboard_is_favorite"
                                    nolabel="1"
                                    class="o_boardkit_dashboard_kanban_favorite"
                                />
                            </div>
                            <div
                                t-if="record.description.raw_value"
                                class="o_boardkit_dashboard_kanban_description text-muted small mb-1"
                                t-esc="record.description.value"
                            />
                            <div class="o_boardkit_dashboard_kanban_meta mt-auto">
                                <field
                                    name="tag_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                                    class="mb-1"
                                />
                                <div
                                    t-if="record.company_id.raw_value"
                                    class="o_boardkit_dashboard_kanban_company mb-1"
                                    t-att-title="record.company_id.value"
                                >
                                    <span
                                        class="badge bg-light text-dark text-truncate"
                                        t-esc="record.company_id.value"
                                    />
                                </div>
                                <div
                                    class="o_boardkit_dashboard_kanban_footer d-flex flex-wrap align-items-center gap-2 pt-2"
                                >
                                    <span
                                        class="o_boardkit_dashboard_kanban_item_count text-muted small"
                                        title="Items"
                                    >
                                        <i class="fa fa-th-large me-1" />
                                        <t
                                            t-esc="record.item_count.raw_value === 1 ? (record.item_count.value + ' Item') : (record.item_count.value + ' Items')"
                                        />
                                    </span>
                                    <span
                                        t-if="record.refresh_interval.raw_value !== '0'"
                                        class="o_boardkit_dashboard_kanban_refresh text-muted small"
                                        title="Auto Refresh"
                                    >
                                        <i class="fa fa-refresh me-1" />
                                        <t t-esc="record.refresh_interval.value" />
                                    </span>
                                    <button
                                        t-if="!record.published.raw_value"
                                        name="action_publish"
                                        type="object"
                                        class="btn btn-sm btn-primary ms-auto o_boardkit_dashboard_kanban_publish"
                                        groups="boardkit_dashboard.group_dashboard_manager"
                                    >Publish</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="boardkit_dashboard_view_list" model="ir.ui.view">
        <field name="name">boardkit.dashboard.list</field>
        <field name="model">boardkit.dashboard</field>
        <field name="arch" type="xml">
            <tree
                js_class="boardkit_dashboard_catalogue_list"
                action="action_open_dashboard"
                type="object"
                default_order="is_favorite desc, name"
            >
                <field
                    name="is_favorite"
                    widget="boardkit_dashboard_is_favorite"
                    nolabel="1"
                    optional="show"
                />
                <field name="name" />
                <field name="description" optional="show" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
                <field name="refresh_interval" optional="show" />
                <field name="menu_parent_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="published" optional="show" />
                <field name="date_filter" optional="hide" />
                <button
                    name="action_open_settings"
                    type="object"
                    string="Settings"
                    class="btn-secondary"
                    icon="fa-cog"
                    title="Dashboard Settings"
                />
            </tree>
        </field>
    </record>

    <record id="boardkit_dashboard_view_search" model="ir.ui.view">
        <field name="name">boardkit.dashboard.search</field>
        <field name="model">boardkit.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
                <field name="tag_ids" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="my_favorites"
                    string="My Favorites"
                    domain="[('is_favorite', '=', True)]"
                />
                <separator />
                <filter
                    name="published"
                    string="Published"
                    domain="[('published', '=', True)]"
                />
                <filter
                    name="not_published"
                    string="Draft"
                    domain="[('published', '=', False)]"
                />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                    groups="boardkit_dashboard.group_dashboard_manager"
                />
                <searchpanel>
                    <field
                        name="favorite_panel"
                        icon="fa-star"
                        select="multi"
                        enable_counters="1"
                    />
                    <field
                        name="tag_ids"
                        icon="fa-tag"
                        select="multi"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="boardkit_dashboard_action" model="ir.actions.act_window">
        <field name="name">Boards</field>
        <field name="res_model">boardkit.dashboard</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start from a template</p>
            <p>Managers can create a board from a curated template, import a JSON
                export, or build one from scratch with tiles, KPIs, charts and lists.
                Published boards you can access appear here.</p>
        </field>
    </record>
</odoo>
