<odoo>
    <record id="boardkit_dashboard_tag_view_form" model="ir.ui.view">
        <field name="name">boardkit.dashboard.tag.form</field>
        <field name="model">boardkit.dashboard.tag</field>
        <field name="arch" type="xml">
            <form string="Dashboard Tag">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="color" widget="color_picker" />
                        <field name="icon" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="boardkit_dashboard_tag_view_list" model="ir.ui.view">
        <field name="name">boardkit.dashboard.tag.list</field>
        <field name="model">boardkit.dashboard.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
                <field name="icon" optional="show" />
            </list>
        </field>
    </record>

    <record id="boardkit_dashboard_tag_view_search" model="ir.ui.view">
        <field name="name">boardkit.dashboard.tag.search</field>
        <field name="model">boardkit.dashboard.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="icon" />
            </search>
        </field>
    </record>

    <record id="boardkit_dashboard_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">boardkit.dashboard.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first tag</p>
            <p>Tags help classify dashboards in the catalogue. Set an icon so
                boards that use the tag show it on their catalogue card (the
                first tag with an icon wins).</p>
        </field>
    </record>
</odoo>
